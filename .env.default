DOMAIN=localhost

IMAGE_VERSION=20260709

POSTGRES_HOSTNAME=postgres
POSTGRES_PORT=5432
POSTGRES_DBNAME=opendatacube
POSTGRES_USER=opendatacube
POSTGRES_PASS=opendatacubepassword

# JupyterHub Configuration
JUPYTERHUB_ADMINS=admin
JUPYTERHUB_USERS=guest

# Copernicus Data Space Ecosystem S3 credentials (required for CDSE-indexed products)
# Generate keys at https://dataspace.copernicus.eu/ — see admin setup guide
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
